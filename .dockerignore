# Keep the build context to source only. Without this the context is ~238MB and
# the user's database and photos get baked into the image — they would ship with
# it if it were ever pushed anywhere.

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime state: bind-mounted at run time, must never be in the image.
data/
media/
!media/**/.gitkeep

# .git stays out of the image. The commit is identified two other ways: a build
# argument, or a read-only mount of .git at run time — see docker-compose.yml.
# Re-including files from an excluded directory here is unreliable across Docker
# versions, and it failed silently when tried.
.git/
.gitignore
dist/
.env
*.bundle
*.sha256

docs/
*.md
!README.md

.DS_Store
.idea/
.vscode/
