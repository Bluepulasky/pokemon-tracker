# Keep the build context to source only. Without this the context is ~238MB and
# the user's database and photos get baked into the image — they would ship with
# it if it were ever pushed anywhere.

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime state: bind-mounted at run time, must never be in the image.
data/
media/
!media/**/.gitkeep

# .git is excluded except the few files that identify the commit. Without them
# an image built with a plain `docker compose build` reports its version as
# "unknown", which is honest but useless — and that is the command people
# actually run. These three add a couple of KB.
.git/*
!.git/HEAD
!.git/refs
!.git/packed-refs
.gitignore
dist/
.env
*.bundle
*.sha256

docs/
*.md
!README.md

.DS_Store
.idea/
.vscode/
