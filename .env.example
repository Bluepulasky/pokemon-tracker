# Free key from https://dev.pokemontcg.io/ — raises the daily limit from 1k to 20k
# requests and noticeably reduces the upstream 500s.
POKEMONTCG_API_KEY=

# Leave empty for no auth (spec §31). Set to any random string if the app is
# reachable from outside the LAN; the UI then needs it in localStorage.app_token.
APP_TOKEN=

# averageSellPrice | trendPrice | avg30 | lowPrice
PRICE_BASIS=averageSellPrice
PRICE_STALE_DAYS=25
MAX_UPLOAD_MB=25
