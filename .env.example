# ---------------------------------------------------------------------------
# Network — the two you are most likely to change
# ---------------------------------------------------------------------------

# Port on the host AND inside the container. Change this one value only.
APP_PORT=8080

# Who can reach it.
#   127.0.0.1  this machine only (default, safest)
#   0.0.0.0    anything on your LAN — set APP_TOKEN below if you do this
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------

# The app has no login (single-user by design). Empty = no auth, which
# is fine on 127.0.0.1. If BIND_ADDR is 0.0.0.0, set this to any random string:
#   openssl rand -hex 24
# The browser needs it once:  localStorage.setItem('app_token', '<value>')
APP_TOKEN=

# ---------------------------------------------------------------------------
# Storage — where the database and photos live on the host
# ---------------------------------------------------------------------------

DATA_PATH=./data
MEDIA_PATH=./media

# Host user that should own those directories. `id -u` and `id -g`.
# Wrong values mean root-owned files on your host, or permission errors.
PUID=1000
PGID=1000

TZ=Europe/Madrid

# ---------------------------------------------------------------------------
# First run
# ---------------------------------------------------------------------------

# There is no bootstrap. A fresh install starts with an empty schema; you add
# sets one at a time from Mantenimiento → Sets, which imports each set's cards,
# its Cardmarket products and prices. Importing needs TCGGO_API_KEY (below).

# ---------------------------------------------------------------------------
# Scheduled price refresh (the `scheduler` container)
# ---------------------------------------------------------------------------

SCHEDULER_CRON_DAY=1          # day of month
SCHEDULER_CRON_HOUR=4         # hour, local TZ
SCHEDULER_RUN_ON_START=0      # 1 = also run once at container start

# ---------------------------------------------------------------------------
# Tuning — sensible defaults, rarely need changing
# ---------------------------------------------------------------------------

HTTP_MAX_BACKOFF=30           # longest a single retry will wait, seconds

WEB_CONCURRENCY=2             # gunicorn workers; 2 is plenty for one user
WEB_THREADS=4
WEB_TIMEOUT=120

CARDMARKET_LOCALE=es          # locale used in outbound Cardmarket links
PRICE_STALE_DAYS=25
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# tcggo — CardMarket API TCG (RapidAPI)  — the one data source
# ---------------------------------------------------------------------------
# Catalogue, card images, versions and prices all come from tcggo. It maps one
# Cardmarket product per printing, which is what the collection needs (a reprint
# and a non-holo are priced as themselves, not as the Base Set holo).
#
# METERED. The plan allows a fixed number of requests per day and charges for
# every one beyond that. TCGGO_DAILY_LIMIT is a hard stop enforced in code and
# counted in the database, so a restart does not hand back a fresh allowance.
# Keep it BELOW the plan's real limit — the gap absorbs retries and the day
# boundary. Raising it spends money.
TCGGO_API_KEY=
TCGGO_DAILY_LIMIT=40
