# ---------------------------------------------------------------------------
# Network — the two you are most likely to change
# ---------------------------------------------------------------------------

# Port on the host AND inside the container. Change this one value only.
APP_PORT=8080

# Who can reach it.
#   127.0.0.1  this machine only (default, safest)
#   0.0.0.0    anything on your LAN — set APP_TOKEN below if you do this
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------

# The app has no login (single-user by design, spec §31). Empty = no auth, which
# is fine on 127.0.0.1. If BIND_ADDR is 0.0.0.0, set this to any random string:
#   openssl rand -hex 24
# The browser needs it once:  localStorage.setItem('app_token', '<value>')
APP_TOKEN=

# ---------------------------------------------------------------------------
# Storage — where the database and photos live on the host
# ---------------------------------------------------------------------------

DATA_PATH=./data
MEDIA_PATH=./media

# Host user that should own those directories. `id -u` and `id -g`.
# Wrong values mean root-owned files on your host, or permission errors.
PUID=1000
PGID=1000

TZ=Europe/Madrid

# ---------------------------------------------------------------------------
# First run
# ---------------------------------------------------------------------------

# 1 = import the catalog automatically on first start (~1,100 cards, a few
#     minutes). 0 = start empty and run `docker compose exec app flask bootstrap`
#     yourself.
AUTO_BOOTSTRAP=1

# STRONGLY RECOMMENDED. Free, takes a minute: https://dev.pokemontcg.io/
#
# Without a key the allowance is 1,000 requests/day. Importing the catalog and
# its images uses most of that, and resolving Cardmarket links is one request
# per card (~1,100) on top — so a keyless install can exhaust the quota and end
# up with half its sets missing.
#
# With a key the allowance is 20,000/day and none of this is a concern.
POKEMONTCG_API_KEY=

# ---------------------------------------------------------------------------
# Scheduled price refresh (the `scheduler` container)
# ---------------------------------------------------------------------------

SCHEDULER_CRON_DAY=1          # day of month
SCHEDULER_CRON_HOUR=4         # hour, local TZ
SCHEDULER_RUN_ON_START=0      # 1 = also run once at container start

# ---------------------------------------------------------------------------
# Tuning — sensible defaults, rarely need changing
# ---------------------------------------------------------------------------

LINK_RESOLVE_WORKERS=3        # parallel requests when resolving Cardmarket links
HTTP_MAX_BACKOFF=30           # longest a single retry will wait, seconds

WEB_CONCURRENCY=2             # gunicorn workers; 2 is plenty for one user
WEB_THREADS=4
WEB_TIMEOUT=120

# Prices come from TCGdex, which is the only source that separates print runs —
# Unlimited and Shadowless are different products with different prices. The
# catalog and images still come from pokemontcg.io.
PRICE_SOURCE=tcgdex
TCGDEX_LANG=en

CARDMARKET_LOCALE=es          # locale used in outbound Cardmarket links
PRICE_BASIS=averageSellPrice  # averageSellPrice | trendPrice | avg30 | lowPrice
PRICE_STALE_DAYS=25
MAX_UPLOAD_MB=25
